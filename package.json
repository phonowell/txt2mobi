{
  "author": "Mimiko Phonowell <phonowell@gmail.com>",
  "bugs": {
    "url": "https://github.com/phonowell/txt2mobi/issues"
  },
  "dependencies": {
    "chardet": "^2.2.0",
    "fire-keeper": "^0.0.237",
    "iconv-lite": "^0.7.3",
    "jimp": "^1.6.1",
    "radash": "^12.1.1"
  },
  "description": "CLI to convert TXT novels and manga folders to MOBI and sync to Kindle",
  "devDependencies": {
    "@types/node": "^25.9.7",
    "@vitest/coverage-v8": "^5.0.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "homepage": "https://github.com/phonowell/txt2mobi#readme",
  "keywords": [
    "txt2mobi",
    "txt-to-mobi",
    "kindle",
    "mobi",
    "ebook-converter",
    "novel",
    "manga",
    "cli",
    "typescript",
    "chinese-novel"
  ],
  "license": "MIT",
  "bin": {
    "txt2mobi": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "readme.md",
    "license.md",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "main": "dist/index.js",
  "name": "txt2mobi",
  "packageManager": "pnpm@11.8.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/phonowell/txt2mobi.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "coverage": "vitest run --coverage",
    "lint": "oxlint --fix src tasks test vitest.config.ts && oxfmt src tasks test vitest.config.ts",
    "prepack": "pnpm build",
    "start": "tsx src/index.ts",
    "task": "tsx tasks/index.ts",
    "test": "vitest run"
  },
  "types": "dist/index.d.ts",
  "type": "module",
  "url": "https://github.com/phonowell/txt2mobi",
  "version": "0.0.6"
}
